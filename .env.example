# Server
PORT=8787
# Public base URL — used as the OAuth issuer and for Google redirect URIs
APP_URL=http://localhost:8787

# Database
DATABASE_URL=postgres://mcp:mcp@localhost:5432/mcp
# Used by docker-compose for the postgres service (defaults to "mcp" if unset)
POSTGRES_PASSWORD=mcp

# Sessions — 32+ random bytes, e.g.: openssl rand -base64 32
SESSION_SECRET=

# Google OAuth (dashboard login) — create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails seeded as active admins at boot (required on fresh DB)
ADMIN_EMAILS=shinchven@gmail.com

# Built-in chat assistant — set at least one to enable the Assistant page.
# Each key enables that provider's latest models in the model picker.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
