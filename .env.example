# Server
# One port for every mode: the Vite dev server (`npm run dev`), the built server
# (`npm start`) and the Docker image all listen here.
PORT=5173

# Public base URL — the OAuth issuer, and the base of the Google redirect URI
# ({APP_URL}/auth/google/callback). Must match the URL you actually open, so
# locally it tracks PORT; in production set it to your public HTTPS URL.
# Register {APP_URL}/auth/google/callback in Google Cloud Console — Google
# matches it as an exact string, or you get redirect_uri_mismatch.
APP_URL=http://localhost:5173

# Database — local development only. docker-compose ignores this and builds its
# own URL from the bundled db service (user/db "finance_mcp", host "db").
DATABASE_URL=postgres://postgres:postgres@localhost:5432/finance_mcp
# Password for the docker-compose postgres service (defaults to "finance_mcp")
POSTGRES_PASSWORD=postgres

# Sessions — 32+ random bytes, e.g.: openssl rand -base64 32
SESSION_SECRET=

# Google OAuth (dashboard login) — create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails seeded as active admins at boot (required on fresh DB)
ADMIN_EMAILS=

# SEC EDGAR requires a descriptive User-Agent with a contact email on every
# request, or it starts rejecting them.
SEC_EDGAR_CONTACT_EMAIL=

# CoinGecko powers `cryptoTickers`. Optional: the public tier used here needs no
# key, and a demo key only raises the rate limit.
COINGECKO_API_KEY=

# iShares egress relay — optional, and only for the two iShares endpoints.
# Akamai blocks some hosts by egress IP (rack8 is one: the fund index answers
# 403 from AkamaiGHost and never reaches iShares). Set both halves to route
# those requests through the fintools-ishares-proxy Cloudflare Worker; leave
# either blank to fetch direct. `npm run ingest -- --provider=ishares --probe`
# prints which route is in use.
ISHARES_PROXY_BASE=
ISHARES_PROXY_TOKEN=
